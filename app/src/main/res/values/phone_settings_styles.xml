<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phone geometry inherits the same surfaces, colors and states as the other devices. -->
    <style name="Widget.BjUnicomIptv.PhoneSettingsLabel" parent="Widget.BjUnicomIptv.SettingsLabel">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.BjUnicomIptv.PhoneSettingsHint" parent="Widget.BjUnicomIptv.SettingsHint">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="Widget.BjUnicomIptv.PhoneSettingsChoice" parent="Widget.BjUnicomIptv.SettingsChoice">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.BjUnicomIptv.PhoneSettingsCheck" parent="Widget.BjUnicomIptv.SettingsCheck">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.BjUnicomIptv.PhoneSettingsCategory" parent="Widget.BjUnicomIptv.HudButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_settings_category</item>
        <item name="android:textColor">@color/settings_category_text</item>
    </style>
    <style name="Widget.BjUnicomIptv.PhoneSettingsAction" parent="Widget.BjUnicomIptv.HudButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_settings_row</item>
        <item name="android:textColor">@color/settings_control_text</item>
    </style>
</resources>
