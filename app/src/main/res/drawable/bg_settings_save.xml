<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/settings_disabled_surface"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#DADADC"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_action"/>
            <corners android:radius="999dp"/>
            <stroke android:width="3dp" android:color="@color/settings_link"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/settings_action"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</selector>
