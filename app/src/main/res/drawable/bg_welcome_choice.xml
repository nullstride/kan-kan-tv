<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_action" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/settings_link" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/settings_action" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_selection" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/settings_label" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#3A3A3E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/welcome_choice_surface" />
            <corners android:radius="14dp" />
            <stroke android:width="0.5dp" android:color="@color/welcome_choice_border" />
        </shape>
    </item>
</selector>
