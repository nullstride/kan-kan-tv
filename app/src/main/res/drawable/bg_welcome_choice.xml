<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_action" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/settings_link" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/settings_action" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#D5353538" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/settings_label" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#D53A3A3E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#A61C1C1E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
        </shape>
    </item>
</selector>
