<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/settings_action"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#66FFFFFF"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/settings_raised"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/settings_selection"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#18FFFFFF"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
