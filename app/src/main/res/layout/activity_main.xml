<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:keepScreenOn="true">
<com.bjunicom.iptv.player.IjkVideoView android:id="@+id/ijk_video_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:focusable="false"/>
<ImageView android:id="@+id/preview_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/preview_landscape" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
<TextView android:id="@+id/preview_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="106dp" android:layout_marginEnd="28dp" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:background="@drawable/bg_md3_hud_surface" android:text="画面预览 · 非直播" android:textColor="@color/text_primary" android:textSize="13sp"/>
<LinearLayout android:id="@+id/loading_overlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/bg_md3_hud_surface" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:visibility="gone">
<ProgressBar android:layout_width="32dp" android:layout_height="32dp" android:indeterminateTint="@color/text_primary"/>
<TextView android:id="@+id/tv_loading_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在连接频道" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginTop="16dp"/>
</LinearLayout>
<TextView android:id="@+id/tv_number_input_osd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="28sp" android:textColor="@color/text_primary" android:layout_gravity="top|end" android:layout_margin="28dp" android:padding="20dp" android:background="@drawable/bg_md3_hud_surface" android:visibility="gone"/>
<RelativeLayout android:id="@+id/player_hud_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:descendantFocusability="afterDescendants">
<LinearLayout android:clipChildren="false" android:clipToPadding="false" android:id="@+id/glass_top_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_margin="24dp" android:padding="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_md3_hud_surface" android:elevation="8dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_toggle_drawer" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="频道" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_menu" android:drawablePadding="8dp" />
<ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_launcher" android:contentDescription="看看电视" android:layout_marginEnd="12dp"/>
<TextView android:id="@+id/tv_top_channel_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="看看电视" android:singleLine="true" android:ellipsize="end" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_open_scanner" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="频道扫描" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_radar" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_open_settings" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="设置" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_settings" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_diagnostics" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="信息" android:textSize="14sp" android:singleLine="true"  />
</LinearLayout>
<LinearLayout android:id="@+id/glass_player_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_margin="24dp" android:padding="16dp" android:orientation="vertical" android:background="@drawable/bg_md3_hud_surface" android:elevation="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/tv_osd_channel_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="24sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-light" android:padding="12dp" android:background="@drawable/bg_channel_num_pill"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
<TextView android:id="@+id/tv_osd_channel_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="24sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end"/>
<TextView android:id="@+id/tv_osd_group_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginTop="5dp"/>
</LinearLayout>
<TextView android:id="@+id/tv_osd_resolution_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/bg_badge" android:padding="8dp"/>
</LinearLayout>
<TextView android:id="@+id/tv_playback_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在连接频道…" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_marginTop="10dp"/>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:clipChildren="false" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none">
<LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:padding="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_prev_channel" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="上一台" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_prev" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_next_channel" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="下一台" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_next" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_numpad_dialog" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="数字选台" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_dialpad" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_favorite_channel" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="收藏" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_star_outline" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_aspect_ratio" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="画面比例" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_aspect_ratio" android:drawablePadding="8dp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_reload_stream" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="重新连接" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_refresh" android:drawablePadding="8dp" />
</LinearLayout></HorizontalScrollView>
<TextView android:id="@+id/tv_remote_help_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="轻点画面收起控制 · 上下滑动换台 · 长按频道收藏" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="6dp"/>
</LinearLayout>
<TextView android:id="@+id/tv_top_stream_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="等待播放信息" android:textSize="12sp" android:textColor="@color/text_primary" android:visibility="gone"/><TextView android:id="@+id/tv_osd_stream_url" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/text_primary" android:visibility="gone"/><TextView android:id="@+id/tv_osd_track_info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/text_primary" android:visibility="gone"/>
</RelativeLayout>
<LinearLayout android:id="@+id/channel_drawer_panel" android:layout_width="480dp" android:layout_height="match_parent" android:layout_gravity="start" android:layout_margin="18dp" android:padding="20dp" android:background="@drawable/bg_md3_drawer_sheet" android:orientation="vertical" android:clickable="true" android:descendantFocusability="afterDescendants" android:elevation="18dp" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_launcher" android:importantForAccessibility="no" android:layout_marginEnd="12dp"/>
<TextView android:id="@+id/tv_drawer_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="看看电视" android:textColor="@color/text_primary" android:textSize="19sp" android:fontFamily="sans-serif-medium"/>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_close_drawer" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="收起" android:textSize="14sp" android:singleLine="true"  />
</LinearLayout>
<EditText android:id="@+id/et_search_channel" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_md3_search_bar" android:drawableStart="@drawable/ic_md_search" android:drawablePadding="10dp" android:paddingHorizontal="16dp" android:hint="搜索频道、台号或组播地址" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="15sp" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:focusableInTouchMode="true" android:nextFocusDown="@id/rv_categories"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
<androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_drawer_numpad" style="@style/Widget.BjUnicomIptv.HudButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" android:text="数字选台" android:textSize="14sp" android:singleLine="true" android:drawableStart="@drawable/ic_flat_dialpad" android:drawablePadding="8dp" android:nextFocusDown="@id/et_search_channel" android:nextFocusRight="@id/cb_only_available"/>
<CheckBox app:buttonIconTint="@color/md_theme_dark_onPrimary" android:id="@+id/cb_only_available" android:layout_width="wrap_content" android:layout_height="48dp" android:buttonTint="@color/md_theme_dark_primary" android:background="@drawable/bg_md3_search_bar" android:paddingHorizontal="8dp" android:text="仅看可用" android:textColor="@color/text_secondary" android:textSize="14sp" android:nextFocusLeft="@id/btn_drawer_numpad" android:nextFocusDown="@id/et_search_channel"/>
</LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_categories" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:paddingVertical="6dp" android:paddingHorizontal="4dp" android:clipToPadding="false" android:focusable="true"/>
<TextView android:id="@+id/tv_channel_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="没有匹配的频道
试试其他分类、搜索词，或关闭“仅看可用”" android:textSize="15sp" android:textColor="@color/text_primary" android:visibility="gone" android:layout_marginTop="24dp" android:gravity="center"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="6dp" android:clipToPadding="false" android:focusable="true" android:scrollbars="vertical"/>
<TextView android:id="@+id/tv_drawer_help" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="点击播放 · 长按收藏" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="8dp" android:gravity="center"/>
</LinearLayout>
    <include layout="@layout/view_timeshift_overlay" />
</FrameLayout>