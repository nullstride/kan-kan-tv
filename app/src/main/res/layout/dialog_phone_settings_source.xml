<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_settings_surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView style="@style/Widget.BjUnicomIptv.PhoneSettingsLabel" android:layout_width="0dp"
            android:layout_weight="1" android:paddingStart="12dp" android:text="选择节目源" android:textSize="15sp" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btn_settings_source_close"
            android:layout_width="44dp" android:layout_height="44dp" android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings_close"
            android:contentDescription="关闭节目源选择" />
    </LinearLayout>
    <FrameLayout android:id="@+id/settings_source_choices" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
